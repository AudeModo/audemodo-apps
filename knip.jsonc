{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  /*
   * 설명할 수 없는 ignore는 두지 않는다. 그래서 JSON이 아니라 JSONC다 —
   * 이유를 곁에 못 적으면 다음 사람이 지워도 되는지 알 수 없다.
   *
   * docs/handoff에는 시안이 준 참고용 .tsx가 있다. 제품 코드가 아니므로
   * 죽은 코드로 잡히면 안 된다.
   *
   * ds-bundle은 뺐다. .gitignore에 있어 knip이 이미 건너뛴다 — 적어두면 중복이고,
   * 중복은 「이것이 왜 필요한가」에 답할 수 없게 만든다.
   */
  "ignore": ["docs/handoff/**"],

  "workspaces": {
    ".": {
      "entry": ["steiger.config.ts"],
    },

    "apps/devlog": {
      /*
       * 라우트가 진입점이다. 여기서 닿지 않는 것은 죽은 코드다.
       *
       * 스냅샷 갱신 스크립트는 적지 않는다 — knip이 package.json의 scripts에서 이미
       * 찾는다. 적었더니 「중복」이라고 짚어줬다.
       */
      "entry": ["app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}"],
      "project": ["{app,src}/**/*.{ts,tsx}"],
    },

    "packages/design-system": {
      /*
       * entry를 적지 않는다. package.json의 exports·main이 이미 src/index.ts를
       * 가리키고 knip이 그것을 읽는다 — 적으면 같은 말을 두 곳에 두는 것이다.
       */
      "project": ["src/**/*.{ts,tsx}"],

      // 서체는 CSS의 @import로만 쓰여 import 그래프에 나타나지 않는다.
      "ignoreDependencies": ["@fontsource/iosevka", "@fontsource/nanum-gothic-coding"],
    },
  },

  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["ds-bundle/**", "docs/handoff/**"],
  "workspaces": {
    ".": {
      "entry": ["steiger.config.ts"]
    },
    "apps/devlog": {
      "entry": ["app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}"],
      "project": ["{app,src}/**/*.{ts,tsx}"]
    },
    "packages/design-system": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@fontsource/iosevka", "@fontsource/nanum-gothic-coding"]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
